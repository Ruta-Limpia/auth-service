                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 con token\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"rol VECINO\", () => pm.expect(r.usuario.rol).to.eql(\"VECINO\"));",
                  "pm.environment.set(\"token_vecino\", r.token);"
                ]
